    "/// @ 0.12.4\n### {\n  name: \"フグパンチボタン\"\n  version: \"0.0.1\"\n  author: \"Misskey Project\"\n}\n\nPlugin:register_post_form_action('フグパンチ', @(note, rewrite) {\n  let fugu = \"ﾌｸﾞﾊﾟﾝﾁ!!!!🐡( '-' 🐡 )\"\n\n  if (note.text.trim() == '') {\n    // ノートの中身がない場合はフグパンチに置き換え\n    rewrite('text', fugu)\n  } else {\n    // ノートの中身がある場合は冒頭にフグパンチを追加して改行\n    rewrite('text', `{fugu}{Str:lf}{note.text}`)\n  }\n})\n",
