{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowJs": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": false,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"~/*": ["./*"]
		},
		"types": ["vite/client"]
	},
	"exclude": [
		"node_modules",
		".output",
		".vrt",
		"scripts/changelog-auto-updater"
	]
}
