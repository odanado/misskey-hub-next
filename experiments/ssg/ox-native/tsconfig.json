{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": false,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node", "vite/client"]
	},
	"include": ["./**/*.ts", "./**/*.d.ts"]
}
